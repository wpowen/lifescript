              {
                "dialogue": {
                  "id": "天机录_ch0666_result_002b_1",
                  "character_id": "char_chenji",
                  "content": "천기压下翻涌的情绪，声音恢复了평온한：\"천도지안……它现在在哪里？有多强？\"",
                  "emotion": "침착"
