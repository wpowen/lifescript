            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0774_012_c",
            "text": "理解母亲",
            "description": "放下所有算计,只是单纯地去感受母亲留下的痕迹,寻找她选择离开的原因。",
            "satisfaction_type": "情感爽",
            "visible_cost": "可能动摇心境",
            "visible_reward": "获得母亲留下的情感寄托",
            "risk_hint": "这可能会触及他内心最柔软的地方",
            "process_label": "어머니 유택感受",
            "stat_effects": [
