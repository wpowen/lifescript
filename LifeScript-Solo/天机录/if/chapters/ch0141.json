            "satisfaction_type": "延迟爽",
            "visible_cost": "背负三个沉重负担",
            "visible_reward": "彻底打入魔道内部，获取核心情报",
            "risk_hint": "三条承诺任何一条无法兑现都将万劫不复",
            "process_label": "以身饲虎",
            "stat_effects": [
