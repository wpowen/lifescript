            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_024",
        "content": "二人激辩至深夜，殿内的烛火都换了两茬。最终，一份密约在火光中拟定——陈机以\"太师\"之名暗中辅佐太子，太子则承诺事成之后给予陈机等同国公的地位与权力。",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_025",
        "content": "太子将密约收入暗格，忽然回头看向陈机，眼中闪过一丝意味深长的光芒。那目光深沉而复杂，仿佛能看透人心最深处的秘密。陈机心中一凛，总觉得那双眼睛里藏着什么他看不透的东西。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0628_026",
        "character_id": "char_tiandaozhiyan",
        "content": "太师，本宫再问你一次——你真的要踏上这条路？天道之眼的注视，可不是开玩笑的。",
        "emotion": "警告"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0628_027",
        "character_id": "char_chenji",
        "content": "陈机瞳孔微缩，但面上依旧波澜不惊：\"殿下也知道天道之眼？\"",
        "emotion": "警觉"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0628_028",
        "character_id": "char_tiandaozhiyan",
        "content": "太子没有回答，只是意味深长地笑了笑。他从袖中取出一枚金色令牌，递到陈机手中：\"这是本宫的私人信物，日后若有需要，可凭此直接面见本宫。\"",
        "emotion": "信任"
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_029",
        "content": "陈机接过令牌，入手温热，隐隐有龙纹浮现。他正要告辞，太子却忽然开口——那句话如同一道惊雷，在寂静的寝殿中炸响。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0628_030",
        "character_id": "char_tiandaozhiyan",
        "content": "太师，朕要的从来不是皇位，而是这个天下姓什么。",
        "emotion": "野望"
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_031",
        "content": "陈机脚步一顿，回首望向太子。那病弱的身躯此刻却散发着睥睨天下的气势，那双眼睛中燃烧着某种近乎疯狂的火焰。陈机忽然明白了——这个看似病弱的储君，其野心之大、格局之广，远超他的想象。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0628_032",
        "character_id": "char_chenji",
        "content": "殿下好大的气魄。既如此，草民愿陪殿下走这一遭。",
        "emotion": "敬佩"
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_033",
        "content": "太子闻言，苍白的脸上终于浮现出一抹真心的笑意。他伸出手，与陈机的手紧紧相握。两只同样隐藏在暗处的手，终于在这一刻正式结盟。窗外夜风骤起，吹得殿内烛火摇曳，两人的影子在墙上交叠，仿佛预示着未来那场席卷天下的风暴。",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_034",
        "content": "就在陈机踏出寝殿的那一刻，太子眼底深处突然闪过一道金色的竖瞳——那竖瞳冰冷而高高在上，与那双病弱温和的眼睛形成了诡异的反差。太子望着陈机离去的背影，喃喃自语：\"有意思……天机录的持有者，天道之眼的棋子……加上本宫这枚暗子，这棋局，终于热闹起来了。\"他的嘴角勾起一抹意味深长的弧度，那笑容中藏着连陈机都看不透的深邃。",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0628_035",
        "content": "当陈机以为一切尽在掌控时，他不知道的是——那位看似病弱的太子，眼底深处正倒映着一道金色的竖瞳，那是天道之眼的标志。皇城夜空中，乌云缓缓遮蔽了星辰，一股无形的压迫感在黑暗中蔓延。暴风雨前的宁静，往往是最危险的时刻。",
        "emphasis": "dramatic"
      }
    }
  ]
}