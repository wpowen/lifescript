              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0078_result_01a_01",
                  "character_id": "char_chenji",
                  "content": "弟子……弟子何德何能，得长老垂青！此恩此德，陈机粉身碎骨难报万一！",
                  "emotion": "激动到声音发颤"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
