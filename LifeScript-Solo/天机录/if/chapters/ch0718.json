            "satisfaction_type": "延迟爽",
            "visible_cost": "较少代价",
            "visible_reward": "了解能力限制",
            "risk_hint": "可能错过最佳时机",
            "process_label": "谨慎验证能力边界",
            "stat_effects": [
              {
                "stat": "天命值",
                "delta": -50
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0718_result_谨慎验证_001",
                  "content": "陈机深吸一口气，将目光锁定在那条黑线上一个极小的分支——那是追杀路上的一个意外变数。他轻轻落笔，那道分支瞬间消散，但一股莫名的虚弱感立刻袭来。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
