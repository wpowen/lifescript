            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0621_012",
        "content": "画面中的陈念转过身，直视着虚空，仿佛能透过时空看到此刻的陈机。她的眼中没有怨恨，只有无尽的温柔和一丝歉意。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0621_013",
        "character_id": "char_chenian",
        "content": "你总说我傻，说我被人卖了还帮人数钱。可哥哥，你才是那个最傻的人。一个人扛着灭门之仇、扛着天机录的诅咒、扛着所有人的算计，你累不累？",
        "emotion": "心疼"
      }
    },
    {
      "text": {
        "id": "天机录_ch0621_014",
        "content": "陈机的嘴唇微微颤抖。画面中，陈念的身后出现了数道黑影——那是圣宗的追兵。她却没有回头，反而将手中长剑插入祭台，剑身上的灵力如潮水般涌出，在祭坛四周形成一道道禁制。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0621_015",
        "character_id": "char_chenian",
        "content": "圣宗的人来了。哥哥，我没时间了。我要告诉你最后一件事——进入时空裂隙后，我会以自身为媒封印部分天机录的气息。这样，你使用天机录时消耗的天命值会大幅减少。但代价是……我可能再也回不来了。",
        "emotion": "平静"
      }
    },
    {
      "text": {
        "id": "天机录_ch0621_016",
        "content": "陈机的指甲深深嵌入掌心，鲜血顺着指缝滴落。他想开口喊停，想告诉她不要这样做，但留言术是单向的，他只能眼睁睁看着画面中的妹妹露出释然的笑容。",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0621_017",
        "content": "陈念最后看了他一眼，那目光中包含了太多太多——十三年来的思念、无法相认的痛苦、以及作为一个妹妹对哥哥最深沉的爱。然后，她转身跃入那道漆黑的时空裂隙，身影瞬间被吞没。禁制同时激发，将所有追兵阻挡在外。",
        "emphasis": "dramatic"
      }
    },
    {
      "choice": {
        "id": "天机录_ch0621_choice_002",
        "prompt": "陈念的留言到此结束。祭坛深处还留有她的修炼痕迹和那枚血契晶石。陈机现在该如何行动？",
        "choice_type": "keyDecision",
        "choices": [
          {
            "id": "天机录_ch0621_opt_003",
            "text": "追查时空裂隙位置",
            "description": "妹妹进入时空裂隙寻找第四页，他必须找到方法追进去。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "巨大风险",
            "visible_reward": "救回妹妹的机会",
            "risk_hint": "时空裂隙危险未知",
            "process_label": "陈机开始探查裂隙痕迹",
            "stat_effects": [],
            "relationship_effects": [],
