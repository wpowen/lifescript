      "dialogue": {
        "id": "天机录_ch0719_016",
        "character_id": "char_tiandaozhiyan",
        "content": "「而第七页——」天机录的声音骤然变得凝重，「就在天机阁总部深处。那片禁地，自天机阁创立以来，从未有人能够活着进入。」",
        "emotion": "警告"
      }
    },
