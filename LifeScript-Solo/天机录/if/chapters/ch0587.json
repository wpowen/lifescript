                "delta": 1
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0587_result_c2_opt3_001",
                  "character_id": "char_suqingyao",
                  "content": "\"太顺利了……\"苏青瑶喃喃道，\"夜清为何会无条件帮你？魔道圣宗的圣女，不可能没有所图。陈机，你真的信任她？\"",
                  "emotion": "疑虑"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
