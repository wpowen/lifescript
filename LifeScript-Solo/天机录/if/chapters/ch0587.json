                "delta": -1
              },
              {
                "character_id": "char_suqingyao",
                "dimension": "敬畏",
                "delta": 2
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0587_result_c1_opt2_001",
                  "character_id": "char_suqingyao",
                  "content": "\"我不是你的工具，\"苏青瑶的声音骤然冷了三分，\"既然要我冒生命危险，总该让我知道，我这颗棋子，究竟在整盘棋的什么位置。\"",
                  "emotion": "质疑"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": "苏青瑶要求更多知情权",
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0587_c1_opt3",
            "text": "试探他对凌渊的态度",
            "description": "苏青瑶作为内门首席，对老掌门凌渊的异常早有察觉，她想借此机会试探陈机对这位暗中掌权者的真实态度。",
            "satisfaction_type": "情感爽",
            "visible_cost": "暴露自己的怀疑",
            "visible_reward": "确认陈机是否为盟友",
            "risk_hint": "可能让陈机警觉",
            "process_label": "试探进行中",
            "stat_effects": [],
            "relationship_effects": [
              {
                "character_id": "char_suqingyao",
                "dimension": "信任",
                "delta": 1
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0587_result_c1_opt3_001",
                  "character_id": "char_suqingyao",
                  "content": "\"老掌门对你……似乎格外关注，\"苏青瑶话锋一转，目光锐利如刀，\"陈机，你老实告诉我，凌渊到底知道多少？\"",
                  "emotion": "审视"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": "苏青瑶与陈机谈及凌渊",
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0587_007",
        "content": "陈机闻言，神色不变，只是微微侧目。月光在他的侧脸上勾勒出一道冷硬的轮廓，让那张原本平凡的面容多了几分难以捉摸的深意。\n\n\"凌渊……\"他轻声念出这个名字，语气中竟带着一丝玩味的笑意，\"师姐既然问了，想必心中已有答案。\"",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0587_008",
        "character_id": "char_chenji",
        "content": "\"他知道的，比你以为的多；他能做的，比你想象的少。\"",
        "emotion": "意味深长"
      }
    },
    {
      "text": {
        "id": "天机录_ch0587_009",
        "content": "这句话让苏青瑶心头一震。她正要追问，陈机却已起身，从暗格中取出一只通体漆黑的玉瓶。瓶中液体微微荡漾，散发出一股若有若无的腥甜气息。\n\n\"魔道秘药，\"陈机将玉瓶轻轻放在桌上，\"服下后可进入假死状态三日，心脉呼吸皆如死人，唯有一处穴位留存一线生机——足够我在关键时刻苏醒。\"",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0587_010",
        "character_id": "char_yeqing",
        "content": "\"这是夜清派人送来的，\"陈机补充道，\"她说这是她欠我的第一笔债。\"",
        "emotion": "淡漠"
      }
    },
    {
      "text": {
        "id": "天机录_ch0587_011",
        "content": "苏青瑶看着那只玉瓶，眉头皱得更紧。魔道之物向来阴毒诡谲，她本能地想要反对，却又想起陈机从不做无把握之事。\n\n\"走火入魔的痕迹，你打算如何伪造？\"她最终问道。\n\n陈机微微一笑，从怀中取出一张符纸。符纸上绘满密密麻麻的阵纹，在昏暗的光线中泛着诡异的暗红色光芒。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0587_012",
        "character_id": "char_chenji",
        "content": "\"走火入魔而死之人，体内经脉必然寸寸断裂。而这张符箓，可以在一炷香之内，模拟出这种伤势。\"",
        "emotion": "冷静"
      }
    },
    {
      "text": {
        "id": "天机录_ch0587_013",
        "content": "他将符箓展开，指尖轻点其中一处阵眼。暗红色的光芒骤然亮起，随即一股狂暴得近乎疯狂的气息从符箓中涌出，让苏青瑶都不禁后退半步。\n\n那气息，与真正的走火入魔几乎一模一样！\n\n\"三日之后赐婚大典，\"陈机收起符箓，声音平静如常，\"我会在这间屋子里服下秘药，届时还需师姐在宗门验尸时……\"",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0587_014",
        "character_id": "char_chenji",
        "content": "\"……睁一只眼闭一只眼。\"",
        "emotion": "淡然"
      }
    },
    {
      "choice": {
        "id": "天机录_ch0587_choice_02",
        "prompt": "苏青瑶沉默片刻。假死计划环环相扣，任何一个细节出错都可能导致满盘皆输。她该如何回应陈机的请求？",
        "choice_type": "keyDecision",
        "choices": [
          {
            "id": "天机录_ch0587_c2_opt1",
            "text": "答应帮忙掩盖死因",
            "description": "苏青瑶决定配合到底，在验尸时做手脚，确保没有人能发现陈机假死的破绽。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "承担欺瞒宗门之罪",
            "visible_reward": "加深与陈机的盟约",
            "risk_hint": "一旦败露，声名尽毁",
            "process_label": "承诺已下",
            "stat_effects": [],
            "relationship_effects": [
              {
                "character_id": "char_suqingyao",
                "dimension": "依赖",
                "delta": 2
              },
              {
                "character_id": "char_suqingyao",
