            "text": "表达深层担忧",
            "description": "苏青瑶内心深处仍有一丝不安，她担心这个计划太过顺利，反而可能是某种陷阱。",
            "satisfaction_type": "阴谋爽",
            "visible_cost": "暴露内心软弱",
            "visible_reward": "获得陈机更多提点",
            "risk_hint": "或显得优柔寡断",
            "process_label": "内心挣扎",
            "stat_effects": [],
            "relationship_effects": [
              {
                "character_id": "char_suqingyao",
