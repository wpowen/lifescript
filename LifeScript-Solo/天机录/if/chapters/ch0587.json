                "delta": 2
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0587_result_c2_opt1_001",
                  "character_id": "char_suqingyao",
                  "content": "\"好。\"苏青瑶的回答简短而坚定。她知道自己已经无法回头——从她决定站在陈机这一边的那一刻起，她们的命运就已经绑在了一起。",
                  "emotion": "决然"
                }
              }
            ],
