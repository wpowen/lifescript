            "description": "苏青瑶愿意配合，但她要求陈机在计划成功后，必须告诉她关于凌渊的真相。",
            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "可能惹恼陈机",
            "visible_reward": "获得关键情报",
            "risk_hint": "陈机或有所保留",
            "process_label": "谈判进行中",
            "stat_effects": [],
            "relationship_effects": [
              {
                "character_id": "char_suqingyao",
                "dimension": "敬畏",
