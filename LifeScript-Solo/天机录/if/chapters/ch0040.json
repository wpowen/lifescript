            "satisfaction_type": "直接爽",
            "visible_cost": "可能显得太嚣张",
            "visible_reward": "全场震撼，废物人设彻底崩塌",
            "risk_hint": "可能引起某些人嫉妒",
            "process_label": "嘲讽拉满",
            "stat_effects": [
