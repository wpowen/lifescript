            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0822_008",
        "content": "殿内一片哗然。众人难以置信地看着那个方才还瑟瑟发抖的杂役弟子，此刻竟敢以如此轻慢的语气对韩烈说话。韩烈的面色骤然阴沉下来，那双虎目中几乎要喷出实质的怒火，周围的空气都在他的怒意下扭曲变形。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0822_009",
        "character_id": "char_hanlie",
        "content": "好胆！本座倒要看看，你这张嘴能不能撑过三招！",
        "emotion": "暴怒"
      }
    },
    {
      "text": {
        "id": "天机录_ch0822_010",
        "content": "韩烈一掌拍出，裹挟着足以毁山裂石的恐怖灵压，直取陈机面门。然而就在众人以为那杂役必死无疑之际，一道苍老的声音自殿后传来：\"韩师侄何必跟一个小辈计较？天青宗的地盘，还轮不到外人撒野。\"凌渊，天青宗老掌门，适时现身。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0822_011",
        "character_id": "char_hanlie",
        "content": "凌老儿，你天青宗窝藏天机录传人，莫非想与三大宗门为敌？本座奉劝你想清楚——这背后的存在，可不是你能招惹的。",
        "emotion": "威胁"
      }
    },
    {
      "text": {
        "id": "天机录_ch0822_012",
        "content": "凌渊面色微变，显然被\"背后的存在\"这四个字刺痛了某根神经。陈机将这一切尽收眼底，心中冷笑——果然，连老狐狸都有忌惮的东西。他不动声色地观察着殿内众人的反应，将每一丝细微的表情变化都刻入脑海。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0822_013",
        "character_id": "char_lingyuan",
        "content": "韩师侄言重了。天青宗向来与三大宗门交好，何来为敌之说？只是这小徒确实只是普通杂役，若有冒犯之处，老夫代为赔罪。",
        "emotion": "虚伪"
      }
    },
    {
      "choice": {
        "id": "天机录_ch0822_choice_002",
        "prompt": "凌渊出面斡旋，但韩烈显然不会善罢甘休。陈机需要决定下一步行动——",
        "choice_type": "styleChoice",
        "choices": [
          {
            "id": "顺水推舟",
            "text": "借势脱身",
            "description": "利用凌渊的庇护暂时脱身，将矛盾引向三大宗门与天青宗的博弈，自己抽身暗处。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "暂时退让",
            "visible_reward": "保存实力",
            "risk_hint": "韩烈可能追查到底",
