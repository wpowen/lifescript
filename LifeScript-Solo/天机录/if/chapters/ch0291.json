            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0291_result_probe_1",
                  "content": "陈机眯起眼睛，眸中精光一闪即逝。他没有拒绝，也没有答应，而是反问了一个更加尖锐的问题。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
