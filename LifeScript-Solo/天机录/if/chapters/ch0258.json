            "satisfaction_type": "直接爽",
            "visible_cost": "天命值 -5",
            "visible_reward": "获得命运推演阵的完整原理",
            "risk_hint": "天眼强行解析可能惊动沉睡的存在",
            "process_label": "天眼解析中",
            "stat_effects": [
