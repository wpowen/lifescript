            "satisfaction_type": "延迟爽",
            "visible_cost": "失去独立人格与记忆主导权",
            "visible_reward": "获得完整天机录与命运双生的全部力量",
            "risk_hint": "一旦融合，将不再是'陈机'",
            "process_label": "命运交汇，灵魂融合中...",
