            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0777_result_third_01",
                  "content": "陈机没有立刻回应，而是闭上双眼，在命运共鸣的边缘地带小心翼翼地试探。他知道融合意味着失去自我，对立则只会两败俱伤。但如果能找到第三种可能呢？",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0777_result_third_02",
                  "character_id": "char_chenji",
                  "content": "「你说得对，我们本是一体。」陈机的声音忽然变得平和，「但一体未必就要融合。你我各走各的路，偶尔在命运的交汇点相遇，岂不比强行合为一体更有意思？」",
                  "emotion": "狡黠"
                }
              }
            ],
            "is_premium": false,
