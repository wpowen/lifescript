            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0382_result_c1_01_01",
                  "content": "陈机深吸一口气，咬破指尖，将鲜血滴入那处凹陷。滚烫的血珠在接触石面的瞬间便化作一道红光，顺着符文的纹路蔓延开去。夜清下意识后退一步，却见陈机面色苍白如纸，身形摇摇欲坠却死死稳住。血脉深处的力量被强行唤醒，一段更加清晰的画面涌入他的脑海——",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0382_result_c1_01_02",
                  "character_id": "char_chenji",
                  "content": "找到了……",
                  "emotion": "激动"
