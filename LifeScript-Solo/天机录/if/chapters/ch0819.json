              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0819_result_009_b_1",
                  "content": "陈机展现出超越常人的冷静，在传承进行到关键时刻强行分出一缕神识去探查那股波动。让他心悸的是，那波动中蕴含的气息竟与天道之眼有几分相似，却又更加古老、更加……危险。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
