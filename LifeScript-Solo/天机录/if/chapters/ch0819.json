            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0819_result_005_b_1",
                  "content": "陈机以惊人的意志力在洪流中保持清醒，如同在惊涛骇浪中稳稳掌舵的舵手。他精准地筛选着有用的信息，将与天机录核心相关的内容尽数吸收，而那些沉重的记忆与情感则被他暂时封存。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
