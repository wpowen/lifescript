                "delta": 40
              },
              {
                "stat": "天命值",
                "delta": -5
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0819_result_009_a_1",
                  "content": "陈机将全部神识灌注进传承之中，以近乎自毁的方式强行加速融合过程。那股力量如沸腾的岩浆般冲刷着他的经脉，虽然过程凶险无比，却也让他在最短时间内触及了天机境界的门槛。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
              "传承隐患"
            ],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0819_009_b",
            "text": "中断查探",
            "description": "暂时中断传承，先探明那股异常波动的来源。",
            "satisfaction_type": "阴谋爽",
            "visible_cost": "传承被迫中断，可能错失最佳时机",
            "visible_reward": "提前发现敌人踪迹，掌握主动权",
            "risk_hint": "稳妥但可能错失机缘",
