                "character_id": "char_suqingyao",
                "dimension": "敬畏",
                "delta": 8
              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0883_result_c1_2_1",
                  "content": "陈机淡淡一笑，那笑容里带着一丝不易察觉的疲惫：「没什么大不了的。只是答应了一位故人，要走完他没能走完的路。」"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0883_result_c1_2_2",
