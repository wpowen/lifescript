            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch1168_result_seek_001",
                  "character_id": "char_chenji",
                  "content": "“前辈，请给晚辈一点时间！”陈机猛然抬头，眼中闪过一丝不甘，“万年的守护，不该就这样结束！一定有办法——一定有！”",
                  "emotion": "不甘"
                }
              },
              {
