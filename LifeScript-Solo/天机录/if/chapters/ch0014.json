            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0014_result_009_c_1",
                  "content": "陈机收起所有伪装，正色道：\"弟子确实有野心，但也有不得不面对的困境。天青宗暗流涌动，凌渊野心勃勃，我需要一个能指点迷津的良师。\"墨先生沉默片刻，残魂的轮廓竟柔和了几分。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0014_result_009_c_2",
                  "character_id": "char_moxiansheng",
                  "content": "好，老夫最厌耍心眼之人。你既有此诚意，老夫便与你直说——凌渊此人，比你想象的更危险百倍。",
                  "emotion": "郑重"
                }
              }
            ],
            "is_premium": false,
