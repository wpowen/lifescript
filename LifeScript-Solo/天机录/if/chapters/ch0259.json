            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0259_result_c4_01",
                  "content": "陈机按兵不动，继续潜伏。那魔道探子嘀咕了几句后便遁入夜色消失不见。就在他松了口气时，身后的黑暗中忽然传来一声轻笑：「陈公子，演技不错嘛。」那声音清冷如霜，却带着一丝揶揄。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
