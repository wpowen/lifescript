            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0380_result_023_b_001",
                  "content": "陈机没有松开手，也没有移开视线。他就这样静静地看着夜清，眼神中那层惯常的冷漠与算计如潮水般退去，露出底下某种复杂而深沉的东西——那是棋手独有的孤独，也是布局者不愿示人的疲惫。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0380_result_023_b_002",
                  "character_id": "char_chenji",
                  "content": "看到了吗？这就是我。",
                  "emotion": "平静"
                }
