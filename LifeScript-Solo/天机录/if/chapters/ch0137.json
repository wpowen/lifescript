            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0137_result_024_01_01",
                  "character_id": "char_chenji",
                  "content": "\"夜圣女过奖了。\"陈机苦笑着摇摇头，\"我不过是个捡破烂的，可能恰好知道一些别人不知道的消息罢了。\"他叹了口气，\"就像这次，夜圣女问路问到我这里，我能有什么办法？总不能把人赶走吧，万一她记仇呢？\"",
                  "emotion": "自嘲自黑"
                }
              }
            ],
