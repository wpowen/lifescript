            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0223_result_01b_1",
                  "content": "陈机缓缓闭上眼睛，胸膛剧烈起伏了几下，又强行压了下去。当他再次睁眼时，那双眸子已经恢复了惯常的平静，只是深处多了一抹连夜清都无法看透的幽暗。他摆了摆手，示意夜清先退下。有些真相，他需要独自消化。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
