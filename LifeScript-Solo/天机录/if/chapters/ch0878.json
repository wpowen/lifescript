            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0878_result_b_001",
                  "character_id": "char_chenji",
                  "content": "陈机眉头紧锁，沉声道：\"等等。预言说第五页的能力是燃烧一切——但谁规定的？\"他再次审视天机录上的文字，寻找可能的漏洞。",
                  "emotion": "冷静"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0878_result_b_002",
                  "content": "墨先生看着他，眼中闪过一丝赞许：\"陈玄当年也在寻找，最终没有找到。但或许……你能走得更远。\"",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
