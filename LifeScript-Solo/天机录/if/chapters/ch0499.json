            "satisfaction_type": "阴谋爽",
            "visible_cost": "消耗精力布局",
            "visible_reward": "引出暗处的敌人，掌握主动权",
            "risk_hint": "若敌人识破计谋，可能被反将一军",
            "process_label": "借力打力",
