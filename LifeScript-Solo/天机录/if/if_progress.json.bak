    "reader_desire_map": {
      "core_fantasy": "玩家扮演算无遗策的幕后棋手，在看似废物的外表下操控全局，用预知未来的外挂编织完美布局，在每个关键时刻打出读者意想不到却早已在计算之内的反转，获得「我就知道他早就布好局了」的极致智斗快感。",
      "reward_promises": [
        "每五章一次大爽点：主角用预见能力提前化解危机，在所有人面前完成不可思议的绝地翻盘",
        "打脸节奏密集：嚣张反派当众羞辱主角后，被主角早已准备好的证据或布局当场打脸，场面极度舒适",
        "终极反转揭示：看似无害的NPC其实是最大幕后黑手，看似绝境却是主角刻意引导的棋局，高潮不断"
      ],
      "control_promises": [
        "关键抉择控制剧情走向：每个重要节点都有多个选项，不同选择通向不同角色关系和结局",
        "角色好感度培养：苏青瑶、夜清等可攻略角色的好感度由玩家选择决定，影响剧情分支和隐藏内容",
        "天命值管理策略：预见能力消耗天命值，玩家需要权衡何时使用、是否值得，掌握节奏感"
      ],
      "suspense_questions": [
        "天机录的完整版本究竟在哪里？每一次使用都在逼近什么终极真相？",
        "陈机预见到自己第700章会死亡——他能否成功改写这个结局？",
        "天道之眼的真正目的是什么？陈玄的传承为何选择了「废物」而不是更强者？"
      ]
    },
    "story_bible": {
      "premise": "废柴弟子陈机意外获得残缺天机录，获得预见未来三时辰的能力却每次使用都消耗珍贵的天命值，他以废物人设行走天下，暗中布局天下，在三大宗门倾轧、魔道入侵、上古禁地开启的乱世中编织无人能破的棋局，然而天机录越完整，命运的必死反噬就越强。",
      "mainline_goal": "陈机的核心目标是改写自己在第700章的死亡预言，同时寻找天机录完整版本，解开被封印的真实命运，最终打破天道之眼的棋局，活出属于自己的命运。",
      "side_threads": [
        "寻找失踪妹妹陈念：她是圣宗手中的「天命锁钥」，她的存在会干扰天机录预见，找到她是卷五核心驱动",
        "攻略苏青瑶：从调查者变为守护者的感情线，需要多次关键选择提升好感度，解锁「共命」buff和专属剧情",
        "收服夜清建立魔道盟友：利用天机录展示的预言震惊魔道圣女，借魔道之手铲除宗门腐败势力",
        "对抗韩烈的蛮力压制：作为谋略对蛮力的镜像对立，韩烈的每次挑战都是对主角布局能力的考验"
      ],
      "hidden_truths": [
        "天机录不是能力而是枷锁：它记录的是必须有人去完成的宿命劫数，陈机是被选中的「执行者」，每次预见都在完成上古预言者未竟的使命",
        "天道之眼的真相：它并非正义的天道，而是利用预言者作为棋子操控世界运转的意识体，天机录只是它众多棋子之一",
        "陈玄的另一个传承者：魔道大军主帅是陈玄的另一个传承者，代表天机录的「反面」，与陈机构成命运的双生子"
      ]
    },
    "route_graph": {
      "mainline": "第一卷废材觉醒打脸宗门长老夺取修炼资源，第二卷宗门暗战揭穿内鬼扶持傀儡，第三卷秘境争锋发现天机录真正来历收服盟友，第四卷魔道渗透反向利用魔道势力，第五卷天命反噬预见自身死亡并假死逃脱，第六卷大陆格局踏入皇朝政治博弈，第七卷上古真相发现天机录是枷锁的真相，第八卷魔道大战统筹全大陆势力对抗上古魔军，第九卷天道裂变面临最终抉择，第十卷棋局终局根据玩家选择走向三条主要结局线。",
      "side_routes": [
        "苏青瑶攻略线：从调查者到守护者的感情升华，好感度达到满值解锁「共命」buff和专属结局片段",
        "夜清合作线：从震惊到信任的魔道圣女结盟之路，魔道迷雾技能解锁后可遮掩天机录气息",
        "韩烈对抗线：从宿敌到被迫结盟再到理念分歧决裂的完整弧线，影响最终结局走向",
        "陈念营救线：贯穿前五卷的亲情线，找到妹妹后解锁新的预见能力和天命值上限"
      ],
      "hidden_routes": [
        "天魔合一隐藏线：需要黑化值≥60且与夜清好感≥70，走魔道传承路线解锁，最终成为游走在预言之外的魔道谋圣",
        "墨先生真相线：完成特定条件后墨先生透露全部真相，解锁隐藏的「陈玄遗迹」深层剧情",
        "凌渊真实身份线：根据玩家选择决定凌渊是最终BOSS还是悲剧性盟友，触发不同结局分支"
      ],
