{
  "bible": {
    "book": {
      "id": "天机录",
      "title": "天机录",
      "author": "命书工作室",
      "cover_image_name": "cover_tianjilu",
      "synopsis": "废柴弟子陈机意外获得残缺天机录，获得预见未来三时辰的能力，却每次使用都要消耗珍贵的天命值。他以废物之姿隐于众人之下，实则每一步都精准算计，在三大宗门倾轧、魔道入侵、上古禁地开启的乱世中，用片刻预见编织无人能破的棋局。但天机录越完整，命运的必死反噬就越强——他看得见所有人的结局，却始终看不透自己的命运。",
      "genre": "修仙升级",
      "tags": [
        "修仙",
        "升级流",
        "谋略",
        "打脸",
        "热血"
      ],
      "interaction_tags": [
        "高互动",
        "选择分支",
        "多结局"
      ],
      "total_chapters": 1200,
      "free_chapters": 30,
      "characters": [
        {
          "id": "char_chenji",
          "name": "陈机",
          "title": "废材陈",
          "avatar_image_name": "avatar_chenji",
          "description": "天青宗杂役弟子，外表懦弱平静，实则内心冷酷、算无遗策。拥有天机录残页，可预见未来三时辰，但每次使用消耗天命值5点。他以废物人设行走江湖，暗中布局天下，是典型的扮猪吃虎型主角。",
          "role": "主角"
        },
        {
          "id": "char_suqingyao",
          "name": "苏青瑶",
          "title": "内门首席",
          "avatar_image_name": "avatar_suqingyao",
          "description": "天青宗内门首席弟子，高冷强硬，是唯一察觉陈机有问题的人。三次无限接近真相，三次被陈机化解。随好感度提升，从调查者逐渐变为守护者，满好感时可解锁「共命」buff，替陈机分担天命值消耗。",
          "role": "红颜"
        },
        {
          "id": "char_yeqing",
          "name": "夜清",
          "title": "魔道圣女",
          "avatar_image_name": "avatar_yeqing",
          "description": "魔道圣宗圣女，表面是侵略者，实则长期被圣宗控制利用。陈机用天机录向她提前展示了一段只有她能理解的预言，震惊之下选择合作。她的「魔道迷雾」技能可遮掩天机录气息，是重要的战略级盟友。",
          "role": "盟友"
        },
        {
          "id": "char_lingyuan",
          "name": "凌渊",
          "title": "老掌门",
          "avatar_image_name": "avatar_lingyuan",
          "description": "天青宗老掌门，对陈机表面庇护实则暗藏祸心。他是陈玄的上一代传承候选人，被天机录跳过之后心生怨恨。每卷都会以更危险的姿态出现，是贯穿全书的隐藏大BOSS候选人。",
          "role": "宿敌"
        },
        {
          "id": "char_hanlie",
          "name": "韩烈",
          "title": "玄武天才",
          "avatar_image_name": "avatar_hanlie",
          "description": "三大宗门中玄武宗第一天才，战力逆天却头脑简单。无法接受被废物反复压制，越败越强。中期被迫结盟，后期因理念分歧决裂。是蛮力路线的极致体现，与陈机构成谋略对蛮力的镜像对立。",
          "role": "宿敌"
        },
        {
          "id": "char_moxiansheng",
          "name": "墨先生",
          "title": "残魂守护者",
          "avatar_image_name": "avatar_moxiansheng",
          "description": "陈玄留下的棋盘守护者，以残魂形态存在于天机录第一页。每完成一卷目标，他解封一页知识。知晓天机录全部真相，但每次只透露该说的部分，本身就是最大的谜团之一。",
          "role": "师尊"
        },
        {
          "id": "char_chenian",
          "name": "陈念",
          "title": "天命锁钥",
          "avatar_image_name": "avatar_chenian",
          "description": "陈机失踪多年的妹妹，被圣宗带走作为「天命锁钥」。她的存在会干扰天机录的预见——任何有她的预见画面都是模糊的。寻找她是卷五核心驱动，也是陈机最大的软肋。",
          "role": "家族"
        },
        {
          "id": "char_tiandaozhiyan",
          "name": "天道之眼",
          "title": "天道意志",
          "avatar_image_name": "avatar_tiandaozhiyan",
          "description": "最终大反派，并非具体的人而是一个超越性的意识体。它将历代预言者当作棋子使用，天机录只是它在世间布下的众多棋子之一。陈机直到卷八才意识到自己一直被注视的恐怖真相。",
          "role": "反派"
        }
      ],
