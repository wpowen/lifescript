              },
              {
                "stat": "天命值",
                "delta": 0
              }
            ],
            "relationship_effects": [
              {
                "character_id": "char_moxiansheng",
                "dimension": "信任",
                "delta": 3
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0335_result_03",
                  "character_id": "char_moxiansheng",
                  "content": "这才是为师想看到的。记住，天机录给你的是预见之力，而非预知之能——你能看到的，永远只是它想让你看到的。",
                  "emotion": "欣慰"
                }
              }
