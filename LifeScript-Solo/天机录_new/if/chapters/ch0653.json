        "choices": [
          {
            "id": "天机录_ch0653_opt_01",
            "text": "接受代价——无论是谁",
            "description": "既然选择了这条路，就要有牺牲的觉悟。无论代价是苏青瑶还是陈念，他都不会停下脚步。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "失去最珍视之人",
            "visible_reward": "解锁第五页封印",
            "risk_hint": "可能永远失去重要的人",
            "process_label": "咬牙接受",
