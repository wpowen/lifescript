                "delta": 1
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch1142_result_reject_temptation_001",
                  "content": "陈机缓缓收敛气息，以一种近乎谦卑的姿态微微躬身：\"前辈既称我为裂痕，想必对这'薄膜'另有图谋。晚辈不过是一枚弃子，何德何能让前辈亲自现身？\""
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch1142_result_reject_temptation_002",
                  "character_id": "char_tiandaozhiyan",
                  "content": "维度来客似乎对他的反应颇感兴趣：\"弃子？不，你是这剧本里唯一写歪的字。正是你的存在，让我们的计划多了三分变数。\"",
                  "emotion": "赞赏"
                }
              }
            ],
