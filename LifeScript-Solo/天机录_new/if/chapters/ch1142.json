            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch1142_result_reject_deal_001",
                  "content": "陈机忽然笑了，那笑容中带着几分决绝：\"前辈怕是找错人了。我陈机虽是废物，却也知道什么叫底线。三界亿万生灵，岂是我一人自由可换的？\""
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch1142_result_reject_deal_002",
                  "character_id": "char_tiandaozhiyan",
                  "content": "维度来客周身图案猛然一滞，似乎没想到他会如此干脆：\"有意思。三维生物中的异类。但你以为你有拒绝的资格吗？\"",
                  "emotion": "威胁"
                }
              }
            ],
            "is_premium": false,
