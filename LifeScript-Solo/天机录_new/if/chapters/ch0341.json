          {
            "id": "truth_accept",
            "text": "接受真相，冷静布局",
            "description": "将愤怒压下，用谋略家的冷静分析这盘万年的棋局，暗中寻找破局之法。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "压抑情绪，暂缓复仇",
            "visible_reward": "获得器灵进一步指引",
            "risk_hint": "可能被视为软弱",
            "process_label": "陈机眼中闪过一丝寒光，随即将所有情绪压入深渊",
            "stat_effects": [
              {
                "stat": "谋略",
                "delta": 3
