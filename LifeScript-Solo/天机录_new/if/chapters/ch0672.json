            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0672_result_001_a_1",
                  "content": "陈机冷笑一声，道：\"帮助我？天机阁的监察者背叛天机阁来帮我？陈灵，你当我三岁小孩吗？\""
                }
              },
              {
