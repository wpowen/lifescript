            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0249_result_opt002_001",
                  "character_id": "char_chenji",
                  "content": "\"你想对付他。\"陈机没有接话，而是平静地说出自己的判断，\"否则你不会告诉我这些。\"",
                  "emotion": "洞察"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0249_result_opt002_002",
                  "character_id": "char_yeqing",
                  "content": "夜清的眼眸微微收缩，随即绽放出一个危险而赞赏的笑容：\"果然和陈玄一样聪明。不错，主帅是我的敌人——也是整个魔道的敌人。\"",
                  "emotion": "欣赏"
                }
              }
            ],
            "is_premium": false,
