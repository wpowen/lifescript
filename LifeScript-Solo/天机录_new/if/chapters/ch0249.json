              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0249_result_opt004_001",
                  "character_id": "char_chenji",
                  "content": "\"合作可以。\"陈机淡淡开口，\"但我需要看到你的诚意——先帮我遮掩一次天机录的气息，让我确认你的能力是真的。\"",
                  "emotion": "谨慎"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0249_result_opt004_002",
                  "character_id": "char_yeqing",
                  "content": "夜清深深地看了他一眼，似乎在评估他的可信度。片刻后，她伸出手：\"成交。但我也有一个条件——你欠我一个人情，将来我要你帮我完成一个任务。\"",
                  "emotion": "满意"
                }
              }
            ],
