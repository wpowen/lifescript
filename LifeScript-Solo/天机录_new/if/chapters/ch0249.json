            "relationship_effects": [],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0249_result_opt001_001",
                  "character_id": "char_chenji",
                  "content": "\"这位主帅，现在何处？\"陈机的声音平静，但眼神却锐利如刀，\"你既然知道这些，应该也清楚他与天机录的关联。\"",
                  "emotion": "锐利"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0249_result_opt001_002",
                  "character_id": "char_yeqing",
                  "content": "夜清似乎对他的直接有些意外，但很快恢复如常：\"他的位置...连我也不确定。但我知道他的目标。\"她的声音低了下来，\"他要收集所有天机录的残页。\"",
                  "emotion": "警告"
                }
              }
            ],
