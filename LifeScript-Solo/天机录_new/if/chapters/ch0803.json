            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "暴露部分实力",
            "visible_reward": "获得陈劫的重新审视",
            "risk_hint": "过早暴露可能让天道之眼调整策略",
            "process_label": "布局者从不打无准备的仗",
            "stat_effects": [
              {
                "stat": "谋略",
                "delta": 2
              }
