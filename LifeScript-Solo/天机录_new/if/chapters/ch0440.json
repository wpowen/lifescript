            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0440_result_mercy_01",
                  "content": "陈机收回目光，神色淡然。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0440_result_mercy_02",
                  "character_id": "char_chenji",
                  "content": "陈执事一时糊涂，念在同门之谊，弟子不愿赶尽杀绝。但若有下次——哼。",
