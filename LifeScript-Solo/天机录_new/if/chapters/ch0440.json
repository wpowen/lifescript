            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0440_result_secret_01",
                  "content": "陈机缓缓抬手，指尖灵力涌动。众人只见他袖中隐隐有金光闪烁，似有什么东西在蠢蠢欲动。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0440_result_secret_02",
                  "character_id": "char_chenji",
                  "content": "诸位长老可知，我陈机虽是废物，却并非毫无所长。三日前，我便已预见今日有人构陷于我——只是没想到，构陷之人如此心急，连证据都伪造得如此拙劣。",
                  "emotion": "冷笑"
