            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0440_result_lingyuan_01",
                  "content": "凌渊抚须沉吟片刻，目光在陈机与陈宏之间来回扫视，神情莫测。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0440_result_lingyuan_02",
                  "character_id": "char_lingyuan",
                  "content": "既是争议，便当验证。陈宏，你将证据呈上；陈机，你所说的证人在何处，一并传来。老夫亲审，定不会偏袒任何人。",
                  "emotion": "威严"
