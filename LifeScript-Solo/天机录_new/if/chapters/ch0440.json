            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0440_result_direct_01",
                  "content": "陈机缓步上前，目光扫过陈宏手中的玉简，嘴角勾起一抹意味深长的笑。",
                  "emphasis": "dramatic"
