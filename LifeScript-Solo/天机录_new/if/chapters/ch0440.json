            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0440_result_cover_01",
                  "content": "陈机不紧不慢地踱了两步，目光意味深长地扫过陈宏，又掠过韩烈。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0440_result_cover_02",
                  "character_id": "char_chenji",
                  "content": "陈执事，你袖口的灵纹很别致啊。不知是哪个“高人”指点你的？这份恩情，可比举报我一个废物要重得多了。",
                  "emotion": "玩味"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0440_result_cover_03",
                  "content": "此言一出，陈宏下意识捂住袖口，而韩烈的脸色骤变。满堂皆知，魔道灵纹最擅伪装——陈机这一句话，等于将勾结魔道的帽子反扣了回去。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
