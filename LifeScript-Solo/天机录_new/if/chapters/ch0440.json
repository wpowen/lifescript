            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0440_result_trap_01",
                  "content": "陈机话锋一转，目光似有若无地扫向高台之上的凌渊。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
