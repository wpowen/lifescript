                "delta": 20
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0938_result_ch0938_opt1_001",
                  "character_id": "char_chenji",
                  "content": "既然天道要看棋局——那便让你看个够。",
                  "emotion": "傲然"
                }
