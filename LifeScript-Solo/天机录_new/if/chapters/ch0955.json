            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0955_result_fuse_01",
                  "content": "陈机盘膝而坐，以神魂之躯面对那巍峨的远古意志。他没有畏惧，也没有臣服，而是平静地伸出了手。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0955_result_fuse_02",
                  "character_id": "char_chenji",
                  "content": "\"你是陈天命，我是陈机。\"他直视着那双蕴含天地奥秘的眼睛，\"我们都是陈家血脉，无需分你我。你给我你的智慧与力量，我给你重新看这个世界的机会。\"\n\n远古意志沉默了片刻，随后发出一声苍老的笑声。",
                  "emotion": "真诚"
                }
              }
            ],
            "is_premium": false,
