                "delta": 8
              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0445_result_019_B_001",
                  "content": "陈机收敛了笑容，退回墨先生身侧，对着圣宗使者微微拱手。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0445_result_019_B_002",
                  "character_id": "char_chenji",
                  "content": "既是误会，说开便好。阁下来此是奉命行事，陈某能理解。请回吧，替陈某向圣宗问好。",
                  "emotion": "平静"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0445_result_019_B_003",
                  "content": "这番话让墨先生眼中闪过一丝赞许——此子深谙进退之道。圣宗使者如蒙大赦，连滚带爬地逃出破庙，发誓再也不踏入此地半步。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
