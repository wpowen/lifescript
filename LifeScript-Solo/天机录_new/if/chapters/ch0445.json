            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0445_result_026_A_001",
                  "content": "陈机沉声道：\"我需要时间。\"墨先生点点头，残魂彻底消散前，留下一枚温热的玉简落入他掌心——那是通往某处秘境的地图。",
                  "emphasis": "dramatic"
                }
              },
              {
