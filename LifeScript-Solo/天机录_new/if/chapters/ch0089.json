            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0089_result_选择_保持警惕_001",
                  "character_id": "char_chenian",
                  "content": "哥？哥你怎么了？我是念儿啊，你……你不认识我了吗？",
                  "emotion": "受伤"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0089_result_选择_保持警惕_002",
                  "content": "陈机松开手，退后半步，目光在陈念脸上逡巡。她眉眼间依稀有幼时轮廓，但十年光阴足以改变太多。他注意到她腕间若隐若现的黑色纹路——那是圣宗印记，绝非伪装能伪造的。\"念儿，你怎么逃出来的？圣宗那些人呢？\"他的语气温和，眸底却闪过一丝不易察觉的冷意——如果这是陷阱，他需要知道是谁在背后布局。",
                  "emphasis": "system"
                }
              }
            ],
            "is_premium": false,
