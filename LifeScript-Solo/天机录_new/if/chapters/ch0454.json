            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "消耗大量天命值",
            "visible_reward": "可能发现圣宗计划的致命漏洞",
            "risk_hint": "时间紧迫，可能两边都落空",
            "process_label": "另辟蹊径",
