            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch1049_result_detail_001",
                  "content": "陈机抬起眼皮，目光变得锐利起来：\"'关键时刻'？'站在这边'？使者大人，咱们明人不说暗话，这种含糊其辞的话术，对我没用。\"",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch1049_result_detail_002",
