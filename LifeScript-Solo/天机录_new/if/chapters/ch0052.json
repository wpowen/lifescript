              {
                "text": {
                  "id": "天机录_ch0052_result_opt001b_001",
                  "content": "陈机故意慢了半拍，被周霆的奔雷剑逼得连连后退。剑光擦着他耳畔掠过，削落几缕发丝。看台上一片惊呼，苏青瑶的笔尖微微一顿。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0052_result_opt001b_002",
                  "character_id": "char_chenji",
                  "content": "好......好快的剑！",
                  "emotion": "惊险"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
              "维持废物人设"
            ],
            "requires_flag": null,
