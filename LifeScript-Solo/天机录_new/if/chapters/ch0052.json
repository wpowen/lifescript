              {
                "text": {
                  "id": "天机录_ch0052_result_opt001a_001",
                  "content": "天机录残页微微发热，三息之后，陈机眼中闪过一丝了然。周霆的剑招轨迹、发力节点、破绽所在——一切尽在掌握。他嘴角微微上扬，身形骤然前冲。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0052_result_opt001a_002",
                  "character_id": "char_chenji",
                  "content": "抱歉，赶时间。",
                  "emotion": "淡然"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
