            "satisfaction_type": "碾压爽",
            "visible_cost": "消耗5点天命值",
            "visible_reward": "名望大幅提升，震慑全场",
            "risk_hint": "暴露太多实力会引起更高层关注",
            "process_label": "催动天机录",
            "stat_effects": [
