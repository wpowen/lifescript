          },
          {
            "id": "天机录_ch0052_opt_001c",
            "text": "以退为进，激怒对手",
            "description": "言语刺激周霆，让他在愤怒中露出破绽",
            "satisfaction_type": "阴谋爽",
            "visible_cost": "可能得罪周家",
            "visible_reward": "削弱对手战力，不耗天命值",
            "risk_hint": "若对方不上当会陷入被动",
