            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0052_result_opt001c_001",
                  "content": "陈机侧身避开剑锋，忽然轻笑出声：\"奔雷剑法？小弟记得......这招的收势似乎有个老毛病？\"周霆脸色骤变，剑招果然一滞。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
