            "satisfaction_type": "情感爽",
            "visible_cost": "可能打乱原有计划",
            "visible_reward": "找到父亲的新方向",
            "risk_hint": "可能是陷阱",
            "process_label": "选择相信父亲活着",
            "stat_effects": [
              {
                "stat": "天命值",
                "delta": -5
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0069_result_trust_truth_001",
                  "content": "陈机紧紧握住玉简，指节因用力而泛白。\n\n十三年了。十三年来他以为父亲早已化作一抔黄土，无数个深夜从噩梦中惊醒，梦见的都是父亲临终前那双不甘的眼睛。",
                  "emphasis": "dramatic"
