            "branch_route_id": null
          },
          {
            "id": "天机录_ch0393_c2_reject",
            "text": "质疑命运，寻求破局",
            "description": "若天机录是枷锁，必有破解之法。父亲当年既敢分割它，我为何不能彻底摆脱？",
            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "与父亲遗志产生冲突",
            "visible_reward": "可能获得打破枷锁的线索",
            "risk_hint": "触怒残魂，错失情感和解机会",
            "process_label": "抗争",
            "stat_effects": [
