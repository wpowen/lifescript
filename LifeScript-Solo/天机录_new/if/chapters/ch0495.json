            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0495_result_020_b_1",
                  "content": "陈机不慌不忙地拍了拍手，那灰袍老者忽然浑身一震，旋即猛地抬头，眼中闪过一丝挣扎。\"周德海……你说只要杀了陈机就帮我洗脱罪名，可我方才收到消息，你早就把我的行踪卖给了玄武宗！\"此言一出，全场哗然。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
