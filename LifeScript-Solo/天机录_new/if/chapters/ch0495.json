            "satisfaction_type": "阴谋爽",
            "visible_cost": "消耗一枚珍贵的棋子",
            "visible_reward": "周家以叛宗罪被三大宗门通缉",
            "risk_hint": "叛修可能临阵倒戈",
            "process_label": "借刀杀人",
            "stat_effects": [
