            "satisfaction_type": "碾压爽",
            "visible_cost": "承受一击",
            "visible_reward": "当众击败周德海，名望大涨",
            "risk_hint": "若演技被识破则前功尽弃",
            "process_label": "扮猪吃虎",
            "stat_effects": [
              {
