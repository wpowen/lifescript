            "satisfaction_type": "延迟爽",
            "visible_cost": "识海被进一步侵入",
            "visible_reward": "获得关键信息片段",
            "risk_hint": "可能暴露你对此的渴望",
            "process_label": "询问天机含义",
            "stat_effects": [],
            "relationship_effects": [],
