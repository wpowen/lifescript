            "branch_route_id": null
          },
          {
            "id": "天机录_ch0318_ask_jiashuo",
            "text": "质问它与陈玄的关系",
            "description": "直接质问它为何知道你是陈玄的继承者，或许能揭开师尊消失的真相。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "可能被它看穿弱点",
