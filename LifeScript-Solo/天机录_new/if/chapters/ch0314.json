            "memory_label": "夜清袒露心声",
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0314_c1_opt2",
            "text": "用沉默给她压力",
            "description": "陈机没有说话，只是静静地看着她，等待她自己说下去。",
            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "可能显得冷漠",
            "visible_reward": "看清她的底牌",
            "risk_hint": "她可能退缩",
