                "stat": "谋略",
                "delta": 3
              }
            ],
            "relationship_effects": [
              {
                "character_id": "char_yeqing",
                "dimension": "依赖",
                "delta": 3
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0314_result_c1_opt2_001",
                  "character_id": "char_yeqing",
                  "content": "夜清沉默片刻，忽然自嘲地笑了：\"你在等我求你？好，我承认，今晚我是来求你的。\"",
                  "emotion": "无奈"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0314_result_c1_opt2_002",
                  "content": "她说完这句话，整个人仿佛都卸下了什么伪装。月光下，她不再是那个高高在上的魔道圣女，只是一个被命运捉弄的普通女子。\n\n陈机心中微动。他第一次看见夜清如此......真实。\n\n\"圣宗需要一个替罪羊。\"她的声音很轻，\"他们选中的那个人，是你。但如果你死了，下一个就是我。\"",
                  "is_premium": false,
                  "flags_set": [],
                  "requires_flag": null,
                  "forbids_flag": null,
                  "stat_gate": null,
                  "memory_label": "夜清的危机",
                  "branch_route_id": null
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0314_008",
        "content": "夜风忽然停了，四周的虫鸣也仿佛在这一刻静默。陈机看着夜清，忽然发现她的手指在微微颤抖。这个杀伐果断的魔道圣女，此刻竟然像个无助的孩子。\n\n\"我记下了。\"他忽然开口，声音很淡，\"圣宗的事，我记下了。\""
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0314_009",
        "character_id": "char_yeqing",
        "content": "\"......你不问我为什么告诉你这些？\"夜清有些惊讶地看着他。",
        "emotion": "意外"
      }
    },
    {
      "text": {
        "id": "天机录_ch0314_010",
        "content": "\"不需要问。\"陈机转过身，重新望向那片黑暗，\"能在这种时候来找我，要么是真心想合作，要么是想让我当冤大头替你挡刀。无论哪种，我都得接着。\"\n\n他顿了顿，声音忽然放轻了一些：\"但我更希望是前者。\""
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0314_011",
        "character_id": "char_yeqing",
        "content": "夜清怔怔地看着他的背影，眼眶忽然有些发热。她想起了自己的过去——在圣宗的那些年里，她学会了不相信任何人，学会了把所有人都当作棋子。可眼前这个被她算计过、被她威胁过、甚至被她追杀过的男人，此刻却给了她从未有过的......安心感。\n\n\"陈机。\"她忽然开口，声音带着从未有过的柔软，\"我想告诉你一些事。关于我的。关于圣宗的。全部。\"",
        "emotion": "下定决心的坚定"
      }
    },
    {
      "choice": {
        "id": "天机录_ch0314_choice_02",
        "prompt": "夜清的话让气氛微微凝滞。她说要告诉他“全部”？这个一直把自己包裹得严严实实的女人，为何会在今夜忽然敞开？",
        "choice_type": "keyDecision",
        "choices": [
          {
            "id": "天机录_ch0314_c2_opt1",
            "text": "\"我听着。\"",
            "description": "陈机没有转身，只是平静地开口，仿佛这只是一场普通的对话。",
            "satisfaction_type": "直接爽",
            "visible_cost": "承担更多秘密",
            "visible_reward": "获得夜清完全信任",
            "risk_hint": "可能被牵连更深的阴谋",
            "process_label": "坦然接受",
            "stat_effects": [
              {
