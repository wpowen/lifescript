            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0729_result_probe_001",
                  "character_id": "char_chenji",
                  "content": "（手指微动）你说你是失败者，却活到了现在。我该如何相信，你不是天道的另一个棋子？",
                  "emotion": "冷冽"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0729_result_probe_002",
                  "content": "墨先生微微一怔，随即苦笑。他似乎察觉到了陈机暗中调动天机录的动作，却并未阻止。",
                  "emphasis": "dramatic"
                }
              }
