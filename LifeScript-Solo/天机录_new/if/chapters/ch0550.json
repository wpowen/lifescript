            "branch_route_id": null
          },
          {
            "id": "天机录_ch0550_opt_c",
            "text": "示弱诱敌，现杀真身",
            "description": "故意露出破绽，引诱幕后操控者现身。适合对付那些自以为掌控全局的蠢货。",
            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "承受一击重伤",
            "visible_reward": "揪出暗处的敌人",
            "risk_hint": "若判断失误可能当场殒命",
            "process_label": "请君入瓮",
            "stat_effects": [
              {
                "stat": "黑化值",
                "delta": 3
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0550_result_c1",
                  "content": "陈机眼中闪过一丝狡黠。他故意脚下一滑，踉跄着撞向傀儡铜爪，鲜血瞬间染红了半边衣襟。\"啊——！\"一声惨嚎响彻废墟。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_011",
        "content": "废墟深处，一道被龙脉浸润了千年的阵法纹路在陈机脚下骤然亮起。金色的光芒冲天而起，将傀儡笼罩其中。那具铜皮铁骨的凶物发出刺耳的嘶鸣，四肢挣扎间却越陷越深。",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_012",
        "content": "陈机擦去嘴角的血迹，居高临下地俯视着困兽犹斗的傀儡。他没有急着下杀手，反而饶有兴致地打量着这具构造精妙的战争机器。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0550_013",
        "character_id": "char_chenji",
        "content": "\"玄武宗的铸甲术...魔道的炼魂法...还有这股熟悉的气息——\"陈机眯起眼睛，声音陡然转冷，\"圣宗的手，伸得还真够长。\"",
        "emotion": "阴冷"
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_014",
        "content": "傀儡的挣扎渐渐微弱，在龙脉之力的洗刷下，它体内残存的意识开始浮现。陈机运转天机录第四页的能力，捕捉到一帧又一帧模糊的画面——圣宗秘殿、血色祭坛、以及一个被铁链锁住的瘦小身影。",
        "emphasis": "dramatic"
      }
    },
    {
      "choice": {
        "id": "天机录_ch0550_choice_02",
        "prompt": "陈机捕捉到的画面越来越清晰，他看到——",
        "choice_type": "styleChoice",
        "choices": [
          {
            "id": "天机录_ch0550_opt_d",
            "text": "死死盯住那个身影",
            "description": "那个身影...是陈念。他的妹妹失踪多年，此刻却出现在圣宗禁地的祭坛上。",
            "satisfaction_type": "情感爽",
            "visible_cost": "精神剧烈消耗",
            "visible_reward": "确认妹妹位置",
            "risk_hint": "可能导致意识过载",
            "process_label": "凝视真相",
            "stat_effects": [
              {
                "stat": "天命值",
                "delta": -5
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0550_result_d1",
                  "content": "陈机的瞳孔猛地收缩。那个被锁链束缚的身影，那张苍白而熟悉的面孔——是他的妹妹，陈念。十六年前她被人掳走，下落不明。原来，她一直都在。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0550_opt_e",
            "text": "截取幕后黑手的画面",
            "description": "情报才是第一位的。找到是谁在操控这一切，才能彻底破局。",
            "satisfaction_type": "阴谋爽",
            "visible_cost": "消耗精力",
            "visible_reward": "获取关键阴谋情报",
            "risk_hint": "画面可能不完整",
            "process_label": "追根溯源",
            "stat_effects": [
              {
                "stat": "谋略",
                "delta": 1
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0550_result_e1",
                  "content": "陈机强压下翻涌的情绪，将目光从妹妹身上移开，转而追寻傀儡意识中那一丝若有若无的操控痕迹。画面飞速切换，最终定格在一个模糊的身影上——那道身影周身环绕着诡异的紫气，头戴玉冠。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_015",
        "content": "傀儡在龙脉阵中发出最后一声哀鸣，漆黑的躯壳开始寸寸崩裂。在彻底消散之前，它残存的意识化作一道微弱的波动，送入陈机脑海——",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_016",
        "content": "\"天...命...锁...钥...七日...之内...否则...\"断断续续的嘶鸣如同一记重锤砸在陈机心头。他的手指微微颤抖，那个词语他再熟悉不过——天命锁钥，传说中能够撬动天道命数的神秘存在。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0550_017",
        "character_id": "char_chenji",
        "content": "陈机垂下眼睫，将翻涌的情绪尽数压入心底最深处。片刻后，他抬起头，嘴角勾起一抹淡漠的弧度：\"七日...够了。\"",
        "emotion": "冷酷"
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_018",
        "content": "废墟归于沉寂。龙脉阵法缓缓收敛光芒，傀儡的残骸化作一地飞灰。陈机站在原地，手中那枚令牌仍微微发烫。天机录第四页的符文安静地悬浮在他的意识深处，等待着下一次觉醒的契机。",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_019",
        "content": "墨先生的声音再次响起，带着几分欣慰：\"命运旁观者...你已初窥门径。接下来，圣宗禁地、七日之期、还有你那位好师兄的布局...这场棋局，才刚刚进入中盘。\"",
        "emphasis": "system"
      }
    },
    {
      "text": {
        "id": "天机录_ch0550_020",
        "content": "陈机没有回答。他最后看了一眼傀儡消散的方向，转身踏入夜色之中。身后，那道孤独的背影渐渐融入黑暗，只有夜风隐约带来他低沉的自语——\"小念，再等哥哥七天。\"",
        "emphasis": "dramatic"
      }
    }
  ]
}