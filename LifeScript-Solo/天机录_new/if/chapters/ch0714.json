              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0714_result_divide_01",
                  "content": "我忽然轻笑一声，语气中带着几分玩味。听说魔道内部并非铁板一块，圣宗与魔宗素有嫌隙。阁下此番前来，是代表圣宗呢，还是另有靠山？",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0714_result_divide_02",
                  "character_id": "char_hanlie",
                  "content": "（神色微变）陈公子消息倒是灵通。不过有些事，不该问的还是别问的好。",
                  "emotion": "警惕"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
