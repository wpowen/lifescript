              "min": 5
            },
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0714_014",
        "content": "就在这时，夜清突然闷哼一声，噬心印猛然亮起刺目的黑光。她的身形摇晃了一下，单膝跪地，额头上冷汗涔涔。那使者却不慌不忙地从怀中取出一枚玉瓶，随手抛向我。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0714_015",
        "character_id": "char_hanlie",
        "content": "（漫不经心）这是抑制噬心印的解药，先给你们。三日之后，我还会再来。到时候，希望陈公子能给我一个满意的答复。",
        "emotion": "玩味"
      }
    },
    {
      "text": {
        "id": "天机录_ch0714_016",
        "content": "黑影一闪，使者已消失在夜色中。我接住那枚玉瓶，入手冰凉，隐隐能感受到其中蕴含的灵力波动。夜清的呼吸渐渐平稳下来，但她的目光却异常复杂地看着我手中的信函和陈机。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0714_017",
        "character_id": "char_yeqing",
        "content": "（低声）陈机，你真的打算……和魔道合作？",
        "emotion": "挣扎"
      }
    },
    {
      "choice": {
        "id": "天机录_ch0714_choice02",
        "prompt": "夜清问出了关键问题。她对魔道既恨又惧，此刻显然在担心陈机会走上与圣宗合作的老路。",
        "choice_type": "characterPref",
        "choices": [
          {
            "id": "reassure_yeqing",
            "text": "安抚夜清",
            "description": "向夜清保证，无论如何都不会让她再受圣宗控制。这是真心话，也是对她的承诺。",
            "satisfaction_type": "情感爽",
            "visible_cost": "暴露软肋",
            "visible_reward": "夜清信任度大幅提升",
            "risk_hint": "可能被视为软弱",
            "process_label": "承诺",
            "stat_effects": [
              {
                "stat": "天命值",
                "delta": -2
              }
            ],
            "relationship_effects": [
              {
                "character_id": "char_yeqing",
