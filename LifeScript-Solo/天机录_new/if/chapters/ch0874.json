            "satisfaction_type": "直接爽",
            "visible_cost": "无消耗",
            "visible_reward": "激怒血月，可能获得更多信息",
            "risk_hint": "激怒敌人可能招致更强的攻击",
            "process_label": "言语反击",
            "stat_effects": [
