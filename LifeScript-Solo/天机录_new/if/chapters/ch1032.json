              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch1032_result_012_c_1",
                  "character_id": "char_yeqing",
                  "content": "「哈哈哈哈！」主帅忽然大笑起来，「好，好一个陈机！你母亲若泉下有知，定会欣慰她生了个和她一样多疑的儿子。放心，我帮你，不是因为善心，而是因为我们的敌人是同一个。」",
                  "emotion": "赞赏"
                }
              }
            ],
            "is_premium": false,
