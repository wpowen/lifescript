            "satisfaction_type": "延迟爽",
            "visible_cost": "压抑情绪可能伤身",
            "visible_reward": "获得关键情报，为复仇铺路",
            "risk_hint": "可能显得冷漠",
            "process_label": "追问真相",
            "stat_effects": [
