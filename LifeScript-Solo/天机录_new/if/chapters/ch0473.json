        "choice_type": "keyDecision",
        "choices": [
          {
            "id": "ch0473_c2_defy",
            "text": "直面威压",
            "description": "我命由我不由天！纵是天道又何惧之有！",
            "satisfaction_type": "碾压爽",
            "visible_cost": "承受反噬",
            "visible_reward": "觉醒血脉之力",
            "risk_hint": "可能重伤神魂",
            "process_label": "硬抗威压",
