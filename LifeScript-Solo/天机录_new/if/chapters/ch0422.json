              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0422_result_c2_1_1",
                  "content": "陈机没有说话，只是抬起头，望向那片浩瀚的星河。良久，他的声音才从喉间溢出，轻得像是叹息。"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0422_result_c2_1_2",
                  "character_id": "char_chenji",
                  "content": "我十二岁那年，在天青宗后山，差点用一根麻绳结束自己。",
                  "emotion": "淡漠"
                }
              }
            ],
            "is_premium": false,
