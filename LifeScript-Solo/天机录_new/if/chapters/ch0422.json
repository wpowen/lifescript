            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0422_result_c1_1_1",
                  "content": "陈机沉默片刻，星空在他的眼底映出冷冽的光芒。他缓缓开口：\"两年。够了。\""
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0422_result_c1_1_2",
                  "character_id": "char_chenji",
                  "content": "我会亲手把这份命运还给他们。",
                  "emotion": "坚定"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
              "夜清信任_初步承诺"
            ],
