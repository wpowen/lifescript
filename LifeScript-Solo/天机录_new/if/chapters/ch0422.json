              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0422_result_c1_3_1",
                  "content": "陈机忽然抬手，指向夜清袖中的心灯。那盏血色的微光似乎感应到了什么，竟微微颤动起来。"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0422_result_c1_3_2",
                  "character_id": "char_chenji",
                  "content": "我能看到一些东西。未来三时辰内的事。代价很大，但我愿意为你预演一次。",
                  "emotion": "意味深长"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
