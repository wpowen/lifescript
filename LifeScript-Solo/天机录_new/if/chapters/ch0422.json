              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0422_result_c1_2_1",
                  "content": "陈机没有立刻回答，而是抬眼望向夜空，仿佛在推演什么。半晌，他轻声道：\"圣宗的'归元大典'需要三位护法同时主持，地点固定在圣山禁地。\""
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0422_result_c1_2_2",
                  "character_id": "char_chenji",
                  "content": "换言之，要救你，得把三个老怪物一起干掉。你觉得我有这本事？",
                  "emotion": "反问"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
