            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch1064_result_choice_001_C_001",
                  "content": "「信任这种东西，我给不起。」陈机摇了摇头，「但我愿意给你一个机会。」",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch1064_result_choice_001_C_002",
                  "character_id": "char_tiandaozhiyan",
                  "content": "「什么机会？」天眼问道。",
                  "emotion": "疑惑"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch1064_result_choice_001_C_003",
                  "character_id": "char_chenji",
                  "content": "「证明你自己的机会。」陈机的目光深邃，「我们各取所需，互不干涉。当你真正站在我这边的时候，我自然会信任你。在那之前——我们只是临时合作者。」",
                  "emotion": "冷静"
                }
