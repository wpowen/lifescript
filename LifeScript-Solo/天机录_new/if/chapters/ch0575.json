              },
              {
                "stat": "黑化值",
                "delta": 2
              }
            ],
            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0575_result_暗中布局_001",
                  "content": "陈机将信笺收入暗格，神色重归平静。\n\n陈念……他找了五年，不差这一时。\n\n但若这陷阱真的与她有关，他会让设局者付出十倍的代价。\n\n窗外夜风呜咽，似在低诉着什么不为人知的秘密。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
