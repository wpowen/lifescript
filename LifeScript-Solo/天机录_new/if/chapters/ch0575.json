              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0575_result_暗度陈仓_001",
                  "content": "陈机没有露面，而是隐于暗处，以天机录捕捉公主情绪的细微波动。\n\n珠帘后的女子似乎早已料到这一幕，嘴角勾起一抹意味深长的弧度：\"陈机……有意思。\""
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
