            "branch_route_id": null
          },
          {
            "id": "暗中布局",
            "text": "暗中布局",
            "description": "按兵不动，先以其他棋子试探陷阱深浅，保存实力。",
            "satisfaction_type": "延迟爽",
            "visible_cost": "可能错过救援时机",
            "visible_reward": "保全自身，掌握主动",
            "risk_hint": "妹妹可能有危险",
            "process_label": "静观其变",
            "stat_effects": [
              {
