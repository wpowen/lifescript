          },
          {
            "id": "暗度陈仓",
            "text": "暗度陈仓",
            "description": "让苏青瑶代为出面，自己在暗处观察公主反应，见微知著。",
            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "错失直接交流机会",
            "visible_reward": "获取公主真实态度",
            "risk_hint": "公主可能察觉被监视",
            "process_label": "隔岸观火",
            "stat_effects": [
              {
                "stat": "谋略",
                "delta": 5
              }
            ],
            "relationship_effects": [
              {
                "character_id": "char_suqingyao",
                "dimension": "信任",
