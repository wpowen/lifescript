            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0063_result_opt02_01",
                  "content": "陈机沉默了片刻，忽然轻声道：「师姐既然问了，我也不好完全欺瞒。」\n\n他抬起手，指尖凝聚出一缕淡淡的灵光——那是炼气七层的灵力波动，转瞬即逝。",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0063_result_opt02_02",
