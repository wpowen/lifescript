            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0802_result_02_B_001",
                  "content": "\"不是敌人？\"陈机冷笑出声，\"那你告诉我，你到底想要什么？\"",
                  "emphasis": "dramatic"
                }
              },
              {
                "dialogue": {
