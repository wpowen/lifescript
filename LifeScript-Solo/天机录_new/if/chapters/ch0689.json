                "dimension": "依赖",
                "delta": -10
              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0689_013_b_result1",
                  "character_id": "char_chenji",
                  "content": "青瑶姑娘这是在向本废物表白？唉，我这废物何德何能……不过，若姑娘不嫌弃，等我把这天下棋局下完，或许可以考虑考虑。",
                  "emotion": "玩味"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0689_013_b_result2",
                  "content": "苏青瑶的笑容僵了一瞬，随即将手抽回，别过脸去望向窗外。良久，她才低声道：「陈机，你什么时候才肯对我说一句真话？」那声音轻得几乎听不见，却重重撞在陈机心上。"
                }
              }
            ],
