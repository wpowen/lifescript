            "relationship_effects": [],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0897_result_inner_dialogue_001",
                  "content": "陈机没有说话，而是将全部神识投入了体内那道蠢蠢欲动的封印之中。刹那间，一个苍老而暴烈的意志涌入他的脑海，那是一道来自远古的怒吼：「吾乃……天机录初代执掌者……仓御天……他骗了所有人……」",
                  "emphasis": "dramatic"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0897_result_inner_dialogue_002",
                  "content": "话音未落，仓御天的投影骤然逼近，那双由符文编织的眼睛死死盯着陈机，仿佛要将他的神魂看穿：「你在与谁对话？」",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
