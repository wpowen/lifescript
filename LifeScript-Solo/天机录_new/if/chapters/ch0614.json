              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0614_result_c1_2_1",
                  "content": "陈机垂首行礼：\"弟子愚钝，还请师尊明示。\"他这副谦卑姿态让墨先生的虚影微微晃动，似乎在审视着他的深浅。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0614_c1_3",
            "text": "直指核心，质问目的",
            "description": "开门见山追问墨先生为何选中自己，打破一切虚伪的客套",
            "satisfaction_type": "直接爽",
            "visible_cost": "彻底撕破脸皮",
            "visible_reward": "最快速度获得真相",
            "risk_hint": "可能触碰到墨先生的逆鳞",
            "process_label": "对质",
            "stat_effects": [
              {
                "stat": "黑化值",
                "delta": 3
              }
            ],
            "relationship_effects": [
              {
                "character_id": "char_moxiansheng",
