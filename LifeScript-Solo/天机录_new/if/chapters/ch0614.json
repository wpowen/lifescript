            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "暴露自己的警觉",
            "visible_reward": "迫使墨先生提前摊牌",
            "risk_hint": "可能触怒师尊，失去获取信息的机会",
            "process_label": "试探",
            "stat_effects": [
