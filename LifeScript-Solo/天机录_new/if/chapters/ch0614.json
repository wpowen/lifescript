              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0614_result_c1_3_1",
                  "content": "陈机抬起头，目光如刀：\"弟子只想知道一件事——您选中我，究竟是为了传承，还是为了……利用？\""
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
