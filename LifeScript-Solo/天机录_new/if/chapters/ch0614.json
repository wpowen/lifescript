            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0614_result_c1_1_1",
                  "content": "陈机没有行礼，直接开口：\"师尊，您自称弟子师尊，可天机录的传承何时有过师徒之分？您究竟是谁？\"话音落下，石室中的空气仿佛凝固了几分。"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          },
          {
            "id": "天机录_ch0614_c1_2",
            "text": "以退为进，静观其变",
            "description": "保持恭顺姿态，让墨先生先亮底牌，再根据情况调整策略",
            "satisfaction_type": "延迟爽",
            "visible_cost": "可能陷入被动",
            "visible_reward": "获取更多关键信息",
            "risk_hint": "若墨先生另有图谋，可能错失先机",
            "process_label": "隐忍",
            "stat_effects": [
              {
