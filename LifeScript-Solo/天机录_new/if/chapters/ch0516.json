            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0516_result_敷衍掩饰_01",
                  "character_id": "char_suqingyao",
                  "content": "苏青瑶盯着他看了许久，忽然冷笑一声：“罢了，你这人向来如此，有事宁愿烂在肚子里也不肯说出口。陈机，你最好祈祷你信任的那些人……真的值得你信任。\"",
                  "emotion": "失望"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
