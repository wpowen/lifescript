            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0260_result_留有余地_001",
                  "character_id": "char_chenji",
                  "content": "陈机收回手，淡淡一笑：“韩师兄说得是，是我多虑了。李师兄，请。”他侧身让开去路，神态自若得仿佛什么都没发生。",
                  "emotion": "隐忍"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0260_result_留有余地_002",
                  "content": "李昊如蒙大赦，转身便要离开。然而他转身的瞬间，袖中玉佩不慎滑落，砸在白玉祭坛上发出清脆声响——魔纹在众人注视下熠熠生辉，刺目得无法忽视。",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
              "li_hao_exposed_subtle"
            ],
            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": "用计谋让李昊自己露出马脚",
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0260_008",
        "character_id": "char_hanlie",
        "content": "这……这是栽赃！姓陈的，是你放进他袖子里的！",
        "emotion": "惊怒"
      }
    },
    {
      "text": {
        "id": "天机录_ch0260_009",
        "content": "韩烈的声音都劈了叉，却更显得欲盖弥彰。陈机拾起那枚魔道玉佩，轻轻一抖，玉佩中竟浮现出数道传音符文——记录的正是李昊与魔道接洽的全过程！",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0260_010",
        "character_id": "char_chenji",
        "content": "栽赃？韩师兄好大的口气。这传音符文乃是阵中天然生成，专为记录闯阵者行迹所设。韩师兄的意思是，我一个筑基初期的废物，还能篡改这阵中天机不成？",
        "emotion": "讽刺"
      }
    },
