              }
            ],
            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0260_result_彻底揭露_001",
                  "character_id": "char_chenji",
                  "content": "陈机眸光骤冷，忽然抬手，一道灵力化作锁链缠向李昊手腕：“既然韩师兄这么护着，不如就让诸位看看，李师兄袖中究竟藏着什么见不得人的东西！”",
                  "emotion": "冷酷"
                }
              },
              {
                "text": {
                  "id": "天机录_ch0260_result_彻底揭露_002",
                  "content": "李昊惊骇欲逃，却被陈机灵力锁链钳制得动弹不得。他袖口被灵力撕开，一枚漆黑的玉佩滚落祭坛——那玉佩上赫然刻着一道魔纹，与魔道圣宗的标志如出一辙！",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
