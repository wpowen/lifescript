            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0702_result_cunning_01",
                  "content": "陈机眼底闪过一丝复杂的光芒，随即将识海中的核心区域牢牢封锁。他愿意相信兄长，但十年来的人心诡谲告诉他，信任必须有所保留。\"说吧，大哥，\"他的声音平静得可怕，\"你需要我做什么？\"",
                  "emphasis": "dramatic"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
              "血脉共鸣_谨慎"
