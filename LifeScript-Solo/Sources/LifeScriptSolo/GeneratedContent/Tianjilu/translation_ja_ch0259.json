          },
          {
            "id": "天机录_ch0259_c2_wait",
            "text": "继续隐藏观察",
            "description": "等夜清主动接触，弄清她的来意再做打算",
            "satisfaction_type": "扮猪吃虎",
            "visible_cost": "错过时机",
            "visible_reward": "掌握更多主动权",
            "risk_hint": "可能错失与夜清的联络机会",
            "process_label": "静观其变",
            "stat_effects": [
