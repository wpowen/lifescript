            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch0314_result_c2_opt1_001",
                  "character_id": "char_yeqing",
                  "content": "夜清は彼の傍に歩み寄り、与他并肩而立。她开始讲述——八岁被带入聖宗，十岁第一次杀人，十五岁成为聖女，十八岁发现自己不过是个傀儡……",
