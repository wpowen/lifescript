      "dialogue": {
        "id": "天机录_ch1037_012",
        "character_id": "char_tiandaozhiyan",
        "content": "\"천기록은 창옥천의[…]\"",
        "emotion": "揭露"
      }
    },
    {
      "text": {
        "id": "天机录_ch1037_013",
        "content": "\"Chen Ji의 숨이[…]\"",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch1037_014",
        "character_id": "char_tiandaozhiyan",
        "content": "\"물론, 너도 선택할 수 있다—[…]\"",
        "emotion": "玩味"
      }
    },
    {
      "text": {
        "id": "天机录_ch1037_015",
        "content": "\"사자가 손을 들어,殿内[…]",
        "emphasis": "dramatic"
      }
    },
    {
      "text": {
        "id": "天机录_ch1037_016",
        "content": "\"Chen Ji의 마음이[…]\"",
        "emphasis": "dramatic"
      }
    },
    {
      "choice": {
        "id": "天机录_ch1037_017",
        "prompt": "\"사자가 한 손을 내밀며,掌心에[…]",
        "choice_type": "keyDecision",
        "choices": [
          {
            "id": "天机录_ch1037_017_a",
            "text": "\"令牌[…]",
            "description": "\"暂时接受旧天道残余의[…]",
            "satisfaction_type": "延迟爽",
            "visible_cost": "\"可能被旧天道残余利用\"",
            "visible_reward": "\"获得一股势力的庇护\"",
            "risk_hint": "\"成为更大棋局中的棋子\"",
            "process_label": "接受招揽",
            "stat_effects": [
