    },
    {
      "choice": {
        "id": "天机录_ch1037_022",
        "prompt": "\"사자가令牌을 조용히[…]",
        "choice_type": "keyDecision",
        "choices": [
          {
            "id": "天机录_ch1037_022_a",
            "text": "\"打破棋局\"",
            "description": "\"既然都是棋子，那便掀翻棋盘。天机录是他的，他要自己执掌命运，哪怕要与天道为敌。\"",
            "satisfaction_type": "直接爽",
            "visible_cost": "\"树敌仓御天，失去天青宗庇护\"",
