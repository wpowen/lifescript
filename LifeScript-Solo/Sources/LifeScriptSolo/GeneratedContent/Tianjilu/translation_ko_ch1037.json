            "result_nodes": [
              {
                "dialogue": {
                  "id": "天机录_ch1037_result_a_001",
                  "character_id": "char_chenji",
                  "content": "\"Chen Ji가 잠시 침묵한 후, 마침내 손을 들어 그令牌을 받았다.令牌入手的瞬间,…]",
                  "emotion": "冷静"
