            "requires_flag": null,
            "forbids_flag": null,
            "stat_gate": null,
            "memory_label": null,
            "branch_route_id": null
          }
        ]
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_015",
        "content": "韓烈が去った後、陳期はゆっくりと腰を起こし、口元に意味深长な微笑みを浮かべた。彼は懐から天機録を取り出し、符文が指尖流转——先ほどの那一暮は、彼が予知看到的一个「可能性」に過ぎなかった。本当に彼感兴趣的是、遠くの混戦の中で，究竟有几个人是彼冲着来的。",
        "emphasis": "system"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_016",
        "character_id": "char_moxiansheng",
        "content": "墨先生の声が脑海に响起，带着无奈：「你这小子、連玄武宗の天才に手玉に取れるとは……不过这一招、確かに漂亮だ。」",
        "emotion": "欣慰"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_017",
        "content": "陳期はかすかに笑い，正要返话，忽然感应到一道熟悉的霊力波動が接近している。彼の脸色微变——それは蘇青瑶の気息であった。内門首席师姐怎么会出现在这种偏僻的地方？难道她也……",
        "emphasis": "system"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_018",
        "character_id": "char_chenji",
        "content": "陳期はすぐに気配を收敛、角の隅に隠れた。彼は心里暗暗叫苦：韓烈那边好糊弄、蘇青瑶可不是这样的人。这位师姐の直感が怖いほど鋭い、稍有不慎就会暴露。",
        "emotion": "緊張"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_019",
        "content": "足音が近づく。陳期は息を殺し、隙間を通じて蘇青瑶の清冷な身影が月光の下で剣のように鋭いのが見えた。彼女の目光が乱れた潜伏處を扫过、眉を微かに寄せ、何かの痕跡を探しているようであった。突然、視線が陳期の潜伏方向定了。",
        "emphasis": "dramatic"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_020",
        "character_id": "char_suqingyao",
        "content": "陳期，我知道你在那里。蘇青瑶の声が清冷如泉，却带着不容置疑：「出て来吧。以私の修为，你躲不过去的。」",
        "emotion": "冷静"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_021",
        "content": "陳期は暗暗叫苦。彼は蘇青瑶が彼を脅しているのではないことを知っていた——この师姐は言うからは実行する人物である。彼は表情を整理し、隅から走了出来，脸上挂着那副慣例の卑屈な笑容：「蘇师姐，您怎么来了？这么晚了还在巡逻，真是辛苦啊……」",
        "emphasis": "system"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_022",
        "character_id": "char_suqingyao",
        "content": "蘇青瑶は彼を上下打量し，眼中闪过复杂的光芒：「韓烈刚才从这里离开了。」彼女は顿了顿：「あなた和他……聊了什么？」",
        "emotion": "吟味"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_023",
        "content": "月光の下、蘇青瑶の身影は剣のように挺然としている。彼女は穏やかに見える眼神の下に、三分の警戒、三分の疑惑、四分の……说不清道不明的情绪が隠れている。陳期の心里苦笑——この师姐の直感が越来越敏锐了，怕是用不了多久、彼那「廃物」の人格が彼女の前で完全に崩壊する。",
        "emphasis": "system"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_024",
        "content": "不过……韓烈那个蠢物が「廃物」と会話をした竟然には、それ自体が最大の破绽であった。蘇青瑶は 方才韓烈が去るときの脸上的表情を思い出し——それは弱者压制後の満足というよりもっと……被人牵着鼻子走而不自知的茫然に似ていた。",
        "emphasis": "system"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_025",
        "character_id": "char_chenji",
        "content": "师姐に汇报すると、韓師兄が人追杀到这里に来て、私がいるのを発見しました……陳期は手を擦了，一脸緊張：「彼は私にいくつか質問して、それから去った。本当に什么都没发生！」",
        "emotion": "心虚"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_026",
        "character_id": "char_suqingyao",
        "content": "什么都没发生？蘇青瑶は冷笑一声、缓慢に接近し、每一步都带着无形の压迫感：「韓烈那个人は蠢は蠢だが，还没蠢到和廃物闲聊的地步。お前は彼に何と言った？」",
        "emotion": "追求"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_027",
        "content": "陳期は後退り一步，脸上闪过一丝慌乱——もちろん、この慌乱に几分是真、几分是假，连他自己都分不清。蘇青瑶の直感が正確すぎる、彼は特に注意する必要がある。",
        "emphasis": "system"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_028",
        "content": "遠くから戦闘の音が次第に静まり、火光が冲天而起，显然有人動用了大威力の法术。蘇青瑶は目を傾け、眉を寄せた——あの先は正是韓烈が去った位置であった。そして陳期は心中默默計算していた：三方混戦、今少なくとも二方が暴露された。",
        "emphasis": "system"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_029",
        "content": "蘇青瑶は目光を收回，重新盯着陳期，忽然问了，看似无关紧要的一句话：「陳期，有没有觉得……你变了很多？」",
        "emotion": "疑惑"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_030",
        "content": "この言葉が突然而来、陳期の心跳が一拍.Skipした。だが彼の脸上仍挂着懦弱な笑容：「师姐说笑了、小的我一直这个样子啊……」彼は眼帘を垂れ、眸中一闪而过の鋭さを隠した。",
        "emphasis": "system"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_031",
        "character_id": "char_suqingyao",
        "content": "蘇青瑶は沈黙片刻，忽然叹了口气、態度が軟化した：「算了，不管你有什么事……若需要帮忙，可以来找我。」说完、彼女は转身离去、身影がすぐに夜色に消えた。",
        "emotion": "複雑"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_032",
        "content": "陳期は彼女の背を向けて去るのを見つめ、口元に玩味な弧度を浮かべた。蘇青瑶好感度、また一点上がったね。彼は目光を收回，重新审视着遠くの火光——この夜は注定不会太平。韓烈那边の闹剧，恐怕才刚刚开始。",
        "emphasis": "system"
      }
    },
    {
      "dialogue": {
        "id": "天机录_ch0128_033",
        "character_id": "char_chenji",
        "content": "韓烈あの蠢物が利用されたことに気づいたら，不知道会气成什么样子……陳期は轻声自语，眼中闪过难得の余裕：「不过、彼の愤怒，应该能派上大用场吧？」",
        "emotion": "期待"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_034",
        "content": "夜風が吹き抜け、遠くの喊杀声と霊力の余波带来。陳期は再び暗がりに身を滑り込み，心中下一步の棋局を盘り始めた。韓烈はすでに局に入り、蘇青瑶の疑惑はとりあえず压制され、那些隐藏在暗处的勢力も姿を现す的时候了。この夜才刚刚开始。",
        "emphasis": "system"
      }
    },
    {
      "text": {
        "id": "天机录_ch0128_035",
        "content": "そして遠くの战场上、韓烈は数人の黑衣人に向かって暴跳如雷。彼は確かに目标に向かって行ったのに，为何会和这些莫名其妙的人打架？必ずあの廃物に騙されたのだ！彼は戻ったら、陳期那张笑脸を引き裂いてやる！",
        "emphasis": "system"
      }
    }
  ]
}