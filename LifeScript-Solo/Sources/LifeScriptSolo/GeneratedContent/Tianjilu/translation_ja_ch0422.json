            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0422_result_c1_1_1",
                  "content": "陳期は黙ってしばらく考え、星空が彼の眼底に冷たい光を映していた。彼はゆっくりと口を開いた：「二年。十分だ。」"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0422_result_c1_1_2",
                  "character_id": "char_chenji",
                  "content": "私はこの運命を彼らの手に返す。",
                  "emotion": "堅固"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [
              "夜清信任_初步承诺"
            ],
            "requires_flag": null,
