              },
              {
                "character_id": "char_yeqing",
                "dimension": "依赖",
                "delta": -5
              }
            ],
            "result_nodes": [
              {
                "text": {
                  "id": "天机录_ch0422_result_c1_2_1",
                  "content": "陳期はすぐに答えず、夜空を見上げた。まるで何かを推演しているようだった。しばらくして、彼低く囁いた：「聖宗の『帰元大典』は三位護法同時主持が必要で、場所は聖山禁地に固定されている。」"
                }
              },
              {
                "dialogue": {
                  "id": "天机录_ch0422_result_c1_2_2",
                  "character_id": "char_chenji",
                  "content": "言い換えれば、あなたを救うには三人の老怪物一并干掉する必要がある。あなた，认为我有この本事？",
                  "emotion": "反問"
                }
              }
            ],
            "is_premium": false,
            "flags_set": [],
            "requires_flag": null,
