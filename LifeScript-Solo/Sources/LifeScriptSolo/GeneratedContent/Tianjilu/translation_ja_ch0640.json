            "satisfaction_type": "阴谋爽",
            "visible_cost": "未確認",
            "visible_reward": "第四頁残頁",
            "risk_hint": "任務の難易度は未知で、行くか帰らぬかかもしれない",
            "process_label": "权衡利弊",
            "stat_effects": [
