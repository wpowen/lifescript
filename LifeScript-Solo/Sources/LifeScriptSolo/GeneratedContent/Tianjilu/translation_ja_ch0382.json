            "satisfaction_type": "直接爽",
            "visible_cost": "天命値-10",
            "visible_reward": "完全な讯息碎片を獲得",
            "risk_hint": "天命値の消費が大きすぎ、運命の死の反噬を引き起こす可能性がある",
            "process_label": "血脈を活性",
